includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/quill/eloquent-relation-inference/extension.neon
    - vendor/tomasvotruba/cognitive-complexity/config/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    scanFiles:
        - _ide_helper_models.php
        - tests/Pest.php

    level: 7

    # Measured maxima in this codebase are 5 (method, generateUniqueTeamSlug) and
    # 4 (class). The package defaults of 9/40 sit an order of magnitude above that
    # and would never fire. These are set just high enough to allow normal growth
    # while catching genuine sprawl before it lands.
    cognitive_complexity:
        function: 8
        class: 20

    ignoreErrors:
        # Spatie's published migration branches on the teams feature and on which
        # pivot columns are configured. Restructuring it would make future
        # re-publishes impossible to diff against upstream for no benefit.
        -
            identifier: complexity.functionLike
            path: database/migrations/*_create_permission_tables.php

        # The factory is declared by #[UseFactory] on the model, which is real code
        # rather than a comment. The `@use HasFactory<XFactory>` docblock only
        # restates it for the analyser. Scoped to the trait-use flavour so missing
        # generics elsewhere are still reported.
        -
            identifier: missingType.generics
            message: '#uses generic trait#'
            path: app/Models/*

        # Relation generics are supplied by quill/eloquent-relation-inference, which
        # reads them from the method body. This rule inspects the declaration rather
        # than the resolved type, so no extension can satisfy it - identifier-based
        # ignoring is PHPStan's documented replacement for the removed
        # checkGenericClassInNonGenericObjectType parameter.
        -
            identifier: missingType.generics
            message: '#return type with generic class Illuminate\\Database\\Eloquent\\Relations#'
